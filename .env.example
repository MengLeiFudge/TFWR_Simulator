# 本地游戏存档目录。Windows 下直接保留 C:\... 形式即可；
# 在 WSL 中运行时，代码会自动把它转换成 /mnt/c/...。
TFWR_SAVE_ROOT=C:\Users\MLJ\AppData\LocalLow\TheFarmerWasReplaced\TheFarmerWasReplaced\Saves\Save0

# 本地游戏安装目录。需要提取资源快照或重建反编译源码时会用到它。
TFWR_GAME_ROOT=D:\Steam\steamapps\common\The Farmer Was Replaced

# R2 用户填写当前 profile 的 BepInEx 目录；留空时使用 TFWR_GAME_ROOT/BepInEx。
# 状态文件和模组日志都由该目录推导。先通过 R2 启动对应 profile 的游戏。
TFWR_BEPINEX_ROOT=
